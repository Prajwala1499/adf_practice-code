{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfbankproject0001"
		},
		"LS_BULK_CSV_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_BULK_CSV'"
		},
		"LS_EXCEL_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_EXCEL_PARQUET'"
		},
		"LS_EXCEL_PARQUET_SINK_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_EXCEL_PARQUET_SINK'"
		},
		"LS_SINK_CSVBULK_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SINK_CSVBULK'"
		},
		"LS_BULK_CSV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbulkload0001.dfs.core.windows.net"
		},
		"LS_EXCEL_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbulkload0001.dfs.core.windows.net/"
		},
		"LS_EXCEL_PARQUET_SINK_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbankproject0001.dfs.core.windows.net/"
		},
		"LS_SINK_CSVBULK_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevbankproject0001.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfbankproject0001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_BULK_CSV_accountKey": {
						"value": "[parameters('LS_BULK_CSV_accountKey')]"
					},
					"LS_EXCEL_PARQUET_accountKey": {
						"value": "[parameters('LS_EXCEL_PARQUET_accountKey')]"
					},
					"LS_EXCEL_PARQUET_SINK_accountKey": {
						"value": "[parameters('LS_EXCEL_PARQUET_SINK_accountKey')]"
					},
					"LS_SINK_CSVBULK_accountKey": {
						"value": "[parameters('LS_SINK_CSVBULK_accountKey')]"
					},
					"LS_BULK_CSV_properties_typeProperties_url": {
						"value": "[parameters('LS_BULK_CSV_properties_typeProperties_url')]"
					},
					"LS_EXCEL_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('LS_EXCEL_PARQUET_properties_typeProperties_url')]"
					},
					"LS_EXCEL_PARQUET_SINK_properties_typeProperties_url": {
						"value": "[parameters('LS_EXCEL_PARQUET_SINK_properties_typeProperties_url')]"
					},
					"LS_SINK_CSVBULK_properties_typeProperties_url": {
						"value": "[parameters('LS_SINK_CSVBULK_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}